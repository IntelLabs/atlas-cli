# Atlas Test Framework Environment Variables

# Storage Configuration
STORAGE_TYPE=database
STORAGE_URL=http://localhost:8080

# Alternative storage options
# STORAGE_TYPE=local-fs
# STORAGE_URL=./test_storage

# Keys
SIGNING_KEY=private.pem
VERIFYING_KEY=public.pem

# Hash Algorithm (sha256, sha384, sha512)
HASH_ALG=sha384

# Author Information
AUTHOR_ORG=Your Organization
AUTHOR_NAME=Your Name

# Output Directory
OUTPUT_DIR=./test_output

# MongoDB (if using database storage)
MONGODB_URI=mongodb://localhost:27017/c2pa_manifests